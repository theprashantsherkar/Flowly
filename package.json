{
  "name": "flowly",
  "version": "0.1.0",
  "private": true,
  "description": "Flowly — a collaborative whiteboard and flow builder",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @flowly/web",
    "dev:api": "npm run start:dev --workspace @flowly/api",
    "dev:collab": "npm run dev --workspace @flowly/collab",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
